<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.cortexops.daily-ai-pm</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>RUNNER=codex /Users/jiexinlv/Documents/CortexOps/scripts/daily-ingest-pipeline.sh</string>
  </array>

  <!-- 09:00 Asia/Shanghai — adjust if Mac system TZ is not Shanghai -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>9</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <!-- After login / wake: run if today's report not yet written -->
  <key>RunAtLoad</key>
  <true/>

  <key>WorkingDirectory</key>
  <string>/Users/jiexinlv/Documents/CortexOps</string>

  <key>StandardOutPath</key>
  <string>/Users/jiexinlv/Documents/CortexOps/state/daily/launchd.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/jiexinlv/Documents/CortexOps/state/daily/launchd.stderr.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>TZ</key>
    <string>Asia/Shanghai</string>
  </dict>
</dict>
</plist>
